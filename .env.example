# TalentLens configuration. Copy to .env for local development (never commit .env).
# Every variable is optional: with none set, the app runs in development mode
# on a local SQLite file in ./instance with owner login disabled.
# Wrap values that contain "$" (password hashes) in single quotes.

# --- Core -------------------------------------------------------------------
# development | production | testing. Defaults to production when RENDER is set (Render sets it).
APP_ENV=development
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Postgres (Neon / Supabase pooler / Render): postgresql://user:password@host:5432/dbname?sslmode=require
# Leave empty to use SQLite at $DATA_DIR/talentlens.db
DATABASE_URL=
# Folder for the SQLite file when DATABASE_URL is empty (default: ./instance)
DATA_DIR=
# Run Alembic migrations automatically at start-up (1/0)
AUTO_MIGRATE=1

# --- Owner account (both required to enable login) ---------------------------
ADMIN_USERNAME=
# Generate with: flask hash-password
ADMIN_PASSWORD_HASH=''

# --- Privacy / retention ------------------------------------------------------
# Saved owner screenings older than this are deleted
RETENTION_DAYS=30
# Bearer token for POST /api/v1/admin/purge (>= 24 chars). Empty = endpoint disabled.
PURGE_TOKEN=

# --- Scoring (see docs/scoring.md) -------------------------------------------
SCORE_WEIGHT_TFIDF=0.40
SCORE_WEIGHT_SKILLS=0.45
SCORE_WEIGHT_SECTIONS=0.15
# Final score cap when a must-have skill is missing (0-100)
MUST_HAVE_CAP=40
# Fewer extracted characters than this triggers the "likely scanned" warning
LOW_TEXT_THRESHOLD=200

# --- Upload limits ------------------------------------------------------------
MAX_FILE_MB=5
MAX_FILES=20
MAX_TOTAL_MB=30
MAX_PDF_PAGES=30
MAX_RESUME_CHARS=100000

# --- Rate limits (in memory, per IP) and proxy -------------------------------
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=900
SCREEN_RATE_LIMIT=30
SCREEN_RATE_WINDOW=600
# Number of trusted reverse proxies in front of the app (1 on Render; auto when RENDER is set)
TRUST_PROXY=0

# --- Local dev server (python app.py only; gunicorn uses PORT) ---------------
HOST=127.0.0.1
PORT=5000

# --- Tests only -----------------------------------------------------------------
# Run the test suite against Postgres instead of temporary SQLite files
TEST_DATABASE_URL=
